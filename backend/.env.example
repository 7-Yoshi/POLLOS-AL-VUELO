# ============================================================
# VARIABLES DE ENTORNO — Backend Pollos al Vuelo (Firebase + Firestore)
# Copiar como .env y rellenar con valores reales.
# NUNCA commitear .env ni firebase-service-account.json al repositorio.
# ============================================================

# Firebase — ID del proyecto (Auth + Cloud Firestore)
FIREBASE_PROJECT_ID=tu-proyecto-firebase

# Opción A (desarrollo local o Render Secret File): ruta al archivo JSON de Service Account
# En Render con Secret File suele ser: /etc/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Opción B (recomendada en Render Free): contenido JSON completo en una sola línea
# Si está definida, tiene prioridad sobre FIREBASE_CREDENTIALS_PATH.
FIREBASE_CREDENTIALS_JSON=

# Emuladores locales de Firebase (opcional, solo para desarrollo/pruebas sin proyecto real)
# Ejecutar: firebase emulators:start --only auth,firestore
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Entorno de ejecución: development | production
APP_ENV=development

# CORS — orígenes permitidos exactos (separados por coma)
# En producción agregar tu dominio de Firebase Hosting: https://tu-proyecto.web.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secreto interno para hashes/utilidades (Firebase gestiona JWT y contraseñas)
SECRET_KEY=cambia_este_secreto_aleatorio_seguro_32_caracteres

# Logs
LOG_LEVEL=INFO

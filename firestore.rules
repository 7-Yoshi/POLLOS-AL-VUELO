rules_version = '2';

// Pollos al Vuelo — Reglas de Seguridad de Cloud Firestore
// Todo el acceso de lectura y escritura de datos se realiza exclusivamente desde
// el backend FastAPI mediante Firebase Admin SDK (que aplica RBAC, aislamiento
// por sucursal, transacciones atómicas y auditoría).
// El cliente web (React) NO accede directamente a Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

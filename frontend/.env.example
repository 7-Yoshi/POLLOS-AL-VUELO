# ============================================================
# VARIABLES DE ENTORNO — Frontend Pollos al Vuelo
# Copiar como .env.local y rellenar con valores reales.
# Las variables VITE_ son públicas (no incluir secretos de servidor).
# ============================================================

# URL base del backend FastAPI (local o Render)
VITE_API_BASE_URL=http://localhost:8000

# Firebase — configuración del cliente web (no es secreta)
VITE_FIREBASE_API_KEY=tu-api-key-de-firebase
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-firebase
VITE_FIREBASE_APP_ID=1:xxxx:web:xxxx

# Opcional: conectar al Firebase Auth Emulator en desarrollo local
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
